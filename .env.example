# =======================================================
# KisanSetu Environment Configuration Template
# Copy this file to .env.local before running the app
# =======================================================

# App Configuration
NEXT_PUBLIC_APP_NAME=KisanSetu
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Microservice Endpoint (FastAPI)
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# OpenStreetMap Tile Server
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Agmarknet Live Data Toggle (false uses built-in high reliability cache)
USE_LIVE_AGMARKNET=false

# Optional: Supabase & Razorpay Sandbox Credentials
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret
